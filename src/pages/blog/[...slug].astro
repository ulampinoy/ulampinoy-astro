---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { netlifyImage, netlifyImageSrcset } from "../../utils/image";
import RecipeCard from "../../components/RecipeCard.astro";
import { getRecipes } from "../../utils/recipe";

// Import the client-side script
import '../../scripts/glossary-links';

// Get the current post from props
const { post } = Astro.props as { post: CollectionEntry<'blog'> };

// Get the Content component
const { Content } = await render(post);
const recipes = getRecipes(post.data);

// Author information is not used in this template

// Format date for display
const formatDate = (dateString: string | Date) => {
  const date = typeof dateString === "string" ? new Date(dateString) : dateString;
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric"
  });
};

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  backgroundImage={post.data.image}
  author={post.data.author || "UlamPinoy"}
  publishedTime={post.data.date.toISOString()}
  modifiedTime={new Date().toISOString()}
>
  <article class="pt-32">
    {/* Hero Image Section - Full Bleed */}
    <div class="relative -mt-16 w-full overflow-hidden">
      <div class="relative h-[44vh] sm:h-[50vh] md:h-[60vh] w-full">
        <div class="absolute inset-0 w-screen left-1/2 -translate-x-1/2">
          <img
            src={netlifyImage(post.data.image, 1200)}
            srcset={netlifyImageSrcset(post.data.image, [400, 800, 1200])}
            sizes="100vw"
            alt={post.data.title}
            width={1200}
            height={800}
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="w-full h-full object-cover"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"
          >
          </div>
        </div>
      </div>
      <div class="absolute inset-0 flex items-end">
        <div class="container mx-auto max-w-3xl px-4 w-full pb-8 md:pb-16">
          <div>
            {
              post.data.whetter && (
                <p class="text-amber-600 text-sm font-medium tracking-wide uppercase mb-4 inline-block">
                  {post.data.whetter}
                </p>
              )
            }
            <h1
              class="savate-heavy text-3xl md:text-5xl lg:text-6xl text-white mb-4"
            >
              {post.data.title}
            </h1>
            <p class="text-xl md:text-2xl text-white/95 mb-6">
              {post.data.description}
            </p>
            <div class="flex items-center text-white/60 text-sm space-x-4">
              <time datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              {
                post.data.author && (
                  <span class="flex items-center">
                    <span class="mx-2">•</span>
                    <span>By {post.data.author}</span>
                  </span>
                )
              }
            </div>
            {
              recipes.length > 0 && (
                <a
                  href="#recipe"
                  class="mt-6 inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-amber-500 hover:bg-amber-600 text-white font-semibold transition-colors"
                >
                  {recipes.length > 1 ? "Jump to Recipes ↓" : "Jump to Recipe ↓"}
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>

    {/* Content Section */}
    <div class="container mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <div
        class="prose prose-sm sm:prose-base md:prose-lg lg:prose-xl dark:prose-invert mx-auto max-w-4xl prose-ul:pl-6"
      >
        <style>
          .prose ul {
            margin-left: 0;
            padding-left: 1.5rem;
          }
          .prose ul > li {
            padding-left: 0.5rem;
            margin-left: 0;
          }
          .prose ul > li:before {
            content: "";
            display: none;
          }
        </style>
        <div
          class="[&_img:not(.not-prose_*)]:mx-auto [&_img:not(.not-prose_*)]:w-full [&_img:not(.not-prose_*)]:max-w-full [&_img:not(.not-prose_*)]:rounded-lg"
        >
          <div
            class="[&>p:first-of-type]:first-letter:float-left [&>p:first-of-type]:first-letter:text-6xl md:[&>p:first-of-type]:first-letter:text-8xl [&>p:first-of-type]:first-letter:pr-2 [&>p:first-of-type]:first-letter:font-bold [&>p:first-of-type]:first-letter:text-amber-500 [&>p:first-of-type]:first-letter:font-[savate] [&>p]:w-[80%] [&>p]:mx-auto [&>p:has(>img)]:w-full"
          >
            <div class="prose dark:prose-invert max-w-none">
              <Content />
            </div>
            {recipes.map((recipe, i) => <RecipeCard post={post.data} recipe={recipe} index={i} slug={post.id} variant="dark" />)}
            
            <!-- Add a script to initialize glossary links -->
            <script>
              const runGlossary = () => {
                if ('linkGlossaryTerms' in window && typeof window.linkGlossaryTerms === 'function') {
                  window.linkGlossaryTerms();
                }
              };
              if ('requestIdleCallback' in window) {
                requestIdleCallback(runGlossary);
              } else {
                document.addEventListener('DOMContentLoaded', runGlossary);
              }
            </script>
          </div>
        </div>
      </div>

      {
        post.data.tags && post.data.tags.length > 0 && (
          <div class="container mx-auto max-w-6xl px-4">
            <div class="mt-12 pt-8 border-t dark:border-zinc-700">
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <a
                    href={`/tags/${tag}`}
                    class="px-3 py-1 bg-gray-100 dark:bg-zinc-800 rounded-sm hover:rounded-lg text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-zinc-700 transition-all"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            </div>
          </div>
        )
      }
    </div>

    <style>
      :global(.prose img:not(:where(.not-prose, .not-prose *))) {
        @apply pt-6;
        width: 100%;
        max-width: 100%;
        height: auto;
        display: block;
        border-radius: 0.5rem;
        box-shadow:
          0 10px 15px -3px rgba(0, 0, 0, 0.1),
          0 4px 6px -2px rgba(0, 0, 0, 0.05);
      }

      @media (prefers-color-scheme: dark) {
        :global(.prose img:not(:where(.not-prose, .not-prose *))) {
          @apply border border-gray-800;
          box-shadow:
            0 4px 6px -1px rgba(0, 0, 0, 0.2),
            0 2px 4px -1px rgba(0, 0, 0, 0.1);
        }
      }

      :global(.prose) {
        @apply text-base sm:text-lg leading-relaxed;
        font-family: "Noto Sans", sans-serif;
        color: inherit;
      }

      :global(.prose p:not(:where(.not-prose, .not-prose *))) {
        @apply mb-6 text-gray-700 dark:text-gray-300;
        line-height: 1.8;
        font-size: 1.125rem;
      }

      :global(.prose > div > div > p:first-of-type:not(:where(.not-prose, .not-prose *))) {
        @apply text-[1.4rem] leading-[1.6] text-gray-800 dark:text-gray-200 mb-8;
      }

      @media (max-width: 640px) {
        :global(.prose p:not(:where(.not-prose, .not-prose *))) {
          @apply text-base leading-7;
        }
      }

      :global(.prose h2:not(:where(.not-prose, .not-prose *))) {
        @apply mt-12 mb-6 text-2xl sm:text-3xl md:text-4xl font-bold leading-tight text-gray-900 dark:text-white;
        font-family: "Savate", serif;
        line-height: 1.3;
      }

      :global(.prose h3:not(:where(.not-prose, .not-prose *))) {
        @apply mt-10 mb-5 text-xl sm:text-2xl font-bold uppercase tracking-wide text-gray-800 dark:text-gray-100;
        font-family: "Savate", serif;
        line-height: 1.4;
      }

      :global(.prose ul:not(:where(.not-prose, .not-prose *))) {
        @apply pl-6 text-gray-700 dark:text-gray-300 list-disc;
      }

      :global(.prose ol:not(:where(.not-prose, .not-prose *))) {
        @apply pl-6 text-gray-700 dark:text-gray-300;
      }

      :global(.prose ul > li:not(:where(.not-prose, .not-prose *))) {
        @apply pl-1 mb-2 ml-0 relative;
      }

      :global(.prose ul > li:not(:where(.not-prose, .not-prose *))::marker) {
        color: #f59e0b; /* amber-500 */
        font-size: 1.2em;
      }

      :global(.prose ol > li:not(:where(.not-prose, .not-prose *))) {
        @apply pl-2 mb-2;
      }

      :global(.prose blockquote:not(:where(.not-prose, .not-prose *))) {
        @apply font-serif text-gray-700 dark:text-gray-300 text-xl italic border-l-4 border-amber-400 pl-6 py-2 my-6 relative;
      }

      :global(.prose blockquote:not(:where(.not-prose, .not-prose *))::before) {
        content: "";
      }

      :global(.prose blockquote p:first-of-type:not(:where(.not-prose, .not-prose *))) {
        margin-top: 0;
      }

      :global(.prose blockquote p:last-of-type:not(:where(.not-prose, .not-prose *))) {
        margin-bottom: 0;
      }

      :global(.prose iframe:not(:where(.not-prose, .not-prose *))) {
        @apply w-full aspect-video my-6 md:my-8;
      }

      :global(.prose .footnotes:not(:where(.not-prose, .not-prose *))) {
        @apply text-sm text-gray-500 dark:text-gray-400 mt-12 pt-6 border-t border-gray-100 dark:border-gray-800;
      }

      :global(.prose .footnotes p:not(:where(.not-prose, .not-prose *))) {
        @apply text-sm leading-relaxed;
      }

      :global(.prose .footnote-backref:not(:where(.not-prose, .not-prose *))) {
        @apply ml-1 text-amber-500 no-underline;
      }
      :global(.prose a:not(:where(.not-prose, .not-prose *))) {
        @apply text-amber-600 hover:text-amber-500 transition-colors underline underline-offset-4 decoration-amber-400/50 hover:decoration-amber-500/70;
      }

      :global(.prose a[href^="#"]:not(:where(.not-prose, .not-prose *))) {
        text-decoration: none;
        position: relative;
        display: inline-block;
        margin: 0 2px;
        padding: 0 4px;
        font-size: 0.8em;
        line-height: 1;
        vertical-align: super;
        color: #f59e0b;
        background-color: rgba(245, 158, 11, 0.1);
        border-radius: 2px;
        transition: all 0.2s ease;
      }

      :global(.prose a[href^="#"]:hover:not(:where(.not-prose, .not-prose *))) {
        background-color: rgba(245, 158, 11, 0.2);
      }
      :global(.prose p:not(:where(.not-prose, .not-prose *))),
      :global(.prose ul:not(:where(.not-prose, .not-prose *))),
      :global(.prose ol:not(:where(.not-prose, .not-prose *))),
      :global(.prose h2:not(:where(.not-prose, .not-prose *))),
      :global(.prose h3:not(:where(.not-prose, .not-prose *))) {
        @apply w-[100%] md:w-[80%] mx-auto my-4;
      }

      :global(.prose h3:not(:where(.not-prose, .not-prose *))),
      :global(.prose h2:not(:where(.not-prose, .not-prose *))) {
        @apply mt-8 md:mt-12;
      }

      :global(.prose ol > li > p:not(:where(.not-prose, .not-prose *))) {
        @apply mx-0 w-full;
      }
    </style>
  </article></BaseLayout
>
